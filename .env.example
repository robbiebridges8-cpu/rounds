# Client-side. Safe to ship in the app bundle; RLS is what protects the data.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Server-side only, used by scripts/seed-pubs.ts. Never import this in app code.
SUPABASE_SERVICE_ROLE_KEY=
